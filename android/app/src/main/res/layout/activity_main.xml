<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="@color/teal"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Giuseppe"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Servizio Health Connect"
                android:textColor="@color/muted_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Version 1.2.0"
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/healthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="○ Health Connect da collegare"
                android:textColor="@color/teal_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Collega Health Connect"
            app:backgroundTint="@color/teal"
            app:icon="@drawable/ic_health"
            app:iconTint="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/linkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ Salute non collegata"
                android:textColor="@color/muted_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pairingCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Codice a 6 cifre"
                android:inputType="number"
                android:maxLength="6"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Collega a Salute"
                app:backgroundTint="@color/drive_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/resultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRONTO"
                android:textColor="@color/teal_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Recupero cardiaco automatico"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Le sessioni si gestiscono dall’app Salute. Questa app lavora in background."
                android:textColor="@color/muted_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSession"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="▶ Avvia sessione"
            app:backgroundTint="@color/status_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="↻ Riprova invio sessione"
            android:visibility="gone"
            app:backgroundTint="@color/status_amber" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecoverSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="↻ Controlla recupero ora"
            app:backgroundTint="@color/drive_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndSession"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="■ Termina sessione"
            app:backgroundTint="@color/status_amber" />

        <LinearLayout
            android:id="@+id/feedbackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valutazione rapida"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ora valuta la sessione da 1 a 5, poi salva."
            android:textColor="@color/muted_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Intensità"
                android:textColor="@color/ink"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/valueIntensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/5"
                android:textColor="@color/status_teal"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seekIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="◎ Controllo"
                android:textColor="@color/ink"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/valueControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/5"
                android:textColor="@color/status_teal"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seekControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="▲ Energia"
                android:textColor="@color/ink"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/valueEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/5"
                android:textColor="@color/status_teal"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seekEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="♡ Benessere"
                android:textColor="@color/ink"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/valueWellbeing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/5"
                android:textColor="@color/status_teal"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seekWellbeing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="✓ Salva in Salute"
            app:backgroundTint="@color/teal_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Se il battito non è ancora disponibile, verrà recuperato successivamente."
            android:textColor="@color/muted_ink"
            android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>